{
  "expo": {
    "name": "Lost&Found",
    "slug": "lostnet",
    "scheme": "lostnet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lostnet.mobile"
    },
    "android": {
      "package": "app.lostnet.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a lost or found item.",
          "cameraPermission": "Photograph a lost or found item."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to help find nearby items."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "platforms": [
      "android",
      "ios"
    ],
    "extra": {
      "eas": {
        "projectId": "87112baa-a72f-45fa-89fc-a027bb64b745"
      }
    }
  }
}
